Zeta3.SuperV.aperyV_three : Zeta3.SuperV.aperyV 3 = 62531 / 36
Zeta3.SuperV.pcongPow_iff : ∀ (p k : ℕ),
  Nat.Prime p → ∀ (x y : ℚ), Zeta3.SuperV.PCongPow p k x y ↔ ¬p ∣ (x - y).den ∧ ↑p ^ k ∣ (x - y).num
