@Zeta3.Harm.pcongZ_sub : ∀ {p : ℕ},
  Nat.Prime p →
    ∀ {x y x' y' : ℚ}, Zeta3.Harm.PCongZ p x y → Zeta3.Harm.PCongZ p x' y' → Zeta3.Harm.PCongZ p (x - x') (y - y')
@Zeta3.Harm.pcongZ_sum : ∀ {p : ℕ},
  Nat.Prime p →
    ∀ {ι : Type u_1} (s : Finset ι) (f g : ι → ℚ),
      (∀ i ∈ s, Zeta3.Harm.PCongZ p (f i) (g i)) → Zeta3.Harm.PCongZ p (∑ i ∈ s, f i) (∑ i ∈ s, g i)
@Zeta3.Harm.pcongZ_mul_left : ∀ {p : ℕ},
  Nat.Prime p → ∀ {x y w : ℚ}, Zeta3.Harm.PInt p w → Zeta3.Harm.PCongZ p x y → Zeta3.Harm.PCongZ p (w * x) (w * y)
@Zeta3.Harm.pcongZ_mul_right : ∀ {p : ℕ},
  Nat.Prime p → ∀ {x y w : ℚ}, Zeta3.Harm.PInt p w → Zeta3.Harm.PCongZ p x y → Zeta3.Harm.PCongZ p (x * w) (y * w)
@Zeta3.Harm.pcongZ_mul : ∀ {p : ℕ},
  Nat.Prime p →
    ∀ {x y x' y' : ℚ},
      Zeta3.Harm.PInt p x →
        Zeta3.Harm.PInt p y' →
          Zeta3.Harm.PCongZ p x y → Zeta3.Harm.PCongZ p x' y' → Zeta3.Harm.PCongZ p (x * x') (y * y')
@Zeta3.Harm.pint_of_pcongZ : ∀ {p : ℕ},
  Nat.Prime p → ∀ {x y : ℚ}, Zeta3.Harm.PInt p y → Zeta3.Harm.PCongZ p x y → Zeta3.Harm.PInt p x
@Zeta3.Harm.pcongZ_natCast : ∀ {p : ℕ}, Nat.Prime p → ∀ {n m : ℕ}, n ≡ m [MOD p] → Zeta3.Harm.PCongZ p ↑n ↑m
@Zeta3.Harm.pcongZ_of_eq_add : ∀ {p : ℕ} {x y z : ℚ}, Zeta3.Harm.PInt p z → x = y + ↑p * z → Zeta3.Harm.PCongZ p x y
@Zeta3.Harm.pcongZ_zero_of_pint : ∀ {p : ℕ} {z : ℚ}, Zeta3.Harm.PInt p z → Zeta3.Harm.PCongZ p (↑p * z) 0
@Zeta3.Harm.pcong_of_pcongZ : ∀ {p : ℕ}, Nat.Prime p → ∀ {x y : ℚ}, Zeta3.Harm.PCongZ p x y → Zeta3.Harm.PCong p x y
@Zeta3.Harm.pcongZ_of_pcong : ∀ {p : ℕ}, Nat.Prime p → ∀ {x y : ℚ}, Zeta3.Harm.PCong p x y → Zeta3.Harm.PCongZ p x y
@Zeta3.Harm.pcongZ_iff_pcong : ∀ {p : ℕ}, Nat.Prime p → ∀ (x y : ℚ), Zeta3.Harm.PCongZ p x y ↔ Zeta3.Harm.PCong p x y
Zeta3.Harm.harm_succ : ∀ (s m : ℕ), Zeta3.Harm.harm s (m + 1) = Zeta3.Harm.harm s m + 1 / ↑(m + 1) ^ s
@Zeta3.Harm.harm_reduce : ∀ {p : ℕ},
  Nat.Prime p →
    ∀ (s m : ℕ), ∃ z, Zeta3.Harm.PInt p z ∧ ↑p ^ s * Zeta3.Harm.harm s m = Zeta3.Harm.harm s (m / p) + ↑p ^ s * z
@Zeta3.Harm.harm_reduce_pcongZ : ∀ {p : ℕ},
  Nat.Prime p →
    ∀ {s : ℕ}, 1 ≤ s → ∀ (m : ℕ), Zeta3.Harm.PCongZ p (↑p ^ s * Zeta3.Harm.harm s m) (Zeta3.Harm.harm s (m / p))
@Zeta3.Harm.pint_harm : ∀ {p : ℕ}, Nat.Prime p → ∀ {m : ℕ}, m < p → ∀ (s : ℕ), Zeta3.Harm.PInt p (Zeta3.Harm.harm s m)
@Zeta3.Harm.pint_pow_mul_harm : ∀ {p : ℕ},
  Nat.Prime p → ∀ (s k m : ℕ), m < p ^ (k + 1) → Zeta3.Harm.PInt p (↑p ^ (k * s) * Zeta3.Harm.harm s m)
@Zeta3.Harm.pint_pow_harm : ∀ {p : ℕ},
  Nat.Prime p → ∀ (s : ℕ) {m : ℕ}, m < p * p → Zeta3.Harm.PInt p (↑p ^ s * Zeta3.Harm.harm s m)
@Zeta3.Harm.pint_pow_two_harm : ∀ {p : ℕ},
  Nat.Prime p → ∀ (s : ℕ) {m : ℕ}, m < p * p * p → Zeta3.Harm.PInt p (↑p ^ (2 * s) * Zeta3.Harm.harm s m)
Zeta3.LucasV.aperyV_zero : Zeta3.LucasV.aperyV 0 = 0
Zeta3.LucasV.aperyV_one : Zeta3.LucasV.aperyV 1 = 6
Zeta3.LucasV.aperyV_two : Zeta3.LucasV.aperyV 2 = 351 / 4
Zeta3.LucasV.aperyV_three : Zeta3.LucasV.aperyV 3 = 62531 / 36
Zeta3.LucasV.pcong_iff_dvd_num : ∀ (p : ℕ) [hp : Fact (Nat.Prime p)] (x y : ℚ),
  Zeta3.LucasV.PCong p x y ↔ ↑p ∣ (x - y).num
Zeta3.LucasV.lucas_v_two : ∀ a < 2,
  ∀ b < 2, Zeta3.LucasV.PCong 2 (2 ^ 3 * Zeta3.LucasV.aperyV (a * 2 + b)) (↑(Zeta3.aperyU b) * Zeta3.LucasV.aperyV a)
Zeta3.LucasV.lucas_v_three : ∀ a < 3,
  ∀ b < 3, Zeta3.LucasV.PCong 3 (3 ^ 3 * Zeta3.LucasV.aperyV (a * 3 + b)) (↑(Zeta3.aperyU b) * Zeta3.LucasV.aperyV a)
Zeta3.LucasV.lucas_v_five : ∀ a < 5,
  ∀ b < 5, Zeta3.LucasV.PCong 5 (5 ^ 3 * Zeta3.LucasV.aperyV (a * 5 + b)) (↑(Zeta3.aperyU b) * Zeta3.LucasV.aperyV a)
Zeta3.VClosed.aperyV_closed_of_beta : ∀ (n : ℕ),
  (∀ j ≤ n,
      ∑ l ∈ (Finset.range (n + 1)).erase j, (-1) ^ l * ↑(Zeta3.aCoeff n l) / (↑l - ↑j) =
        (-1) ^ j * ↑(Zeta3.aCoeff n j) * Zeta3.VClosed.aperyDelta n j) →
    Zeta3.VClosed.aperyV n =
      ∑ j ∈ Finset.range (n + 1),
        ↑(Zeta3.aCoeff n j) ^ 2 * (Zeta3.VClosed.harm 3 j + Zeta3.VClosed.aperyDelta n j * Zeta3.VClosed.harm 2 j)
Zeta3.VClosed.aperyBeta_closed_small : ∀ n ≤ 5,
  ∀ j ≤ n,
    ∑ l ∈ (Finset.range (n + 1)).erase j, (-1) ^ l * ↑(Zeta3.aCoeff n l) / (↑l - ↑j) =
      (-1) ^ j * ↑(Zeta3.aCoeff n j) * Zeta3.VClosed.aperyDelta n j
Zeta3.VClosed.aperyV_closed_small : ∀ n ≤ 5,
  Zeta3.VClosed.aperyV n =
    ∑ j ∈ Finset.range (n + 1),
      ↑(Zeta3.aCoeff n j) ^ 2 * (Zeta3.VClosed.harm 3 j + Zeta3.VClosed.aperyDelta n j * Zeta3.VClosed.harm 2 j)
Zeta3.VClosed.aperyV_one : Zeta3.VClosed.aperyV 1 = 6
Zeta3.VClosed.aperyV_two : Zeta3.VClosed.aperyV 2 = 351 / 4
Zeta3.VClosed.aperyV_three : Zeta3.VClosed.aperyV 3 = 62531 / 36
@Zeta3.RowCol.zeta2_diag_of_row_col : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (T : ℕ → ℕ → K),
  (∀ (n m : ℕ), (↑n + 2) ^ 2 * T (n + 2) m = (2 * ↑n + 3) * (2 * ↑m + 1) * T (n + 1) m + (↑n + 1) ^ 2 * T n m) →
    (∀ (n m : ℕ),
        2 * (↑m + 1) ^ 2 * T n (m + 1) =
          (↑n + 1) ^ 2 * T (n + 1) m + (2 * (↑m + 1) ^ 2 - 2 * (↑n + 1) * (↑m + 1) + (↑n + 1) ^ 2) * T n m) →
      ∀ (n : ℕ), 2 * T (n + 1) (n + 1) = T n n + 5 * T (n + 1) n
@Zeta3.RowCol.mix_of_row_col : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (T : ℕ → ℕ → K),
  (∀ (n m : ℕ),
      (↑n + 2) ^ 3 * T (n + 2) m + (↑n + 1) ^ 3 * T n m =
        ((↑n + 1) ^ 3 + (↑n + 2) ^ 3 + 2 * ↑m * (↑m + 1) * (2 * ↑n + 3)) * T (n + 1) m) →
    (∀ (n l : ℕ),
        (↑l + 1) ^ 3 * T n (l + 1) =
          (↑n + 1) ^ 3 * T (n + 1) l +
            (↑l + 1 - (↑n + 1)) * ((↑n + 1) ^ 2 - (↑n + 1) * (↑l + 1) + (↑l + 1) ^ 2) * T n l) →
      ∀ (n : ℕ), T (n + 1) (n + 1) + T n n = 6 * T (n + 1) n
@Zeta3.RowCol.commute_companion : ∀ {K : Type u_1} [inst : CommRing K] (c d : K) (M : Matrix (Fin 2) (Fin 2) K),
  M * !![0, 1; c, d] = !![0, 1; c, d] * M ↔ M = M 0 0 • 1 + M 0 1 • !![0, 1; c, d]
@Zeta3.RowCol.eq_companion_of_commute : ∀ {K : Type u_1} [inst : CommRing K] (c d : K) (M : Matrix (Fin 2) (Fin 2) K),
  M 0 0 = 0 → M 0 1 = 1 → M * !![0, 1; c, d] = !![0, 1; c, d] * M → M = !![0, 1; c, d]
@Zeta3.RowCol.eq_half_of_commute : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (M : Matrix (Fin 2) (Fin 2) K),
  M 0 0 = 1 / 2 → M 0 1 = 1 / 2 → M * !![0, 1; 1, 4] = !![0, 1; 1, 4] * M → M = !![1 / 2, 1 / 2; 1 / 2, 5 / 2]
