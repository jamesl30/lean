Output of `#check @name` for every declaration of CLAIMED.txt, in that order.

Zeta3.criterion : ∀ (a p q : ℤ) (b : ℕ), 1 ≤ b → 0 < ↑q * (↑a / ↑b) - ↑p → 1 / ↑b ≤ ↑q * (↑a / ↑b) - ↑p
@Zeta3.apery_of_row_and_six : ∀ {K : Type u_1} [inst : Field K] (f : ℕ → ℕ → K),
  (∀ (n m : ℕ), f n m = f m n) →
    (∀ (n m : ℕ),
        1 ≤ n →
          (↑n + 1) ^ 3 * f (n + 1) m + ↑n ^ 3 * f (n - 1) m =
            (↑n ^ 3 + (↑n + 1) ^ 3 + 2 * ↑m * (↑m + 1) * (2 * ↑n + 1)) * f n m) →
      (∀ (n : ℕ), f (n + 1) (n + 1) + f n n = 6 * f (n + 1) n) →
        ∀ (n : ℕ),
          1 ≤ n →
            (↑n + 1) ^ 3 * f (n + 1) (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * f n n +
                ↑n ^ 3 * f (n - 1) (n - 1) =
              0
@Zeta3.wronskian_step : ∀ {K : Type u_1} [inst : Field K] (u z : ℕ → K),
  (∀ (n : ℕ),
      1 ≤ n → (↑n + 1) ^ 3 * u (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * u n + ↑n ^ 3 * u (n - 1) = 0) →
    (∀ (n : ℕ),
        1 ≤ n → (↑n + 1) ^ 3 * z (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * z n + ↑n ^ 3 * z (n - 1) = 0) →
      ∀ (k : ℕ),
        1 ≤ k → (↑k + 1) ^ 3 * (u (k + 1) * z k - u k * z (k + 1)) = ↑k ^ 3 * (u k * z (k - 1) - u (k - 1) * z k)
@Zeta3.rho_succ : ∀ {K : Type u_1} [inst : Field K] (n : ℕ) (t : K),
  Zeta3.rho (n + 1) t = Zeta3.rho n t * (↑n + 1 - t) / (↑n + 1 + t)
@Zeta3.rho_shift : ∀ {K : Type u_1} [inst : Field K] (n : ℕ) (t : K),
  t + ↑n + 1 ≠ 0 → t ^ 2 * Zeta3.rho n t = (t - ↑n) * (t + ↑n + 1) * Zeta3.rho n (t + 1)
@Zeta3.six_identity : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (n : ℕ) (t : K),
  t + ↑n + 1 ≠ 0 →
    Zeta3.rho (n + 1) t ^ 2 + Zeta3.rho n t ^ 2 - 6 * Zeta3.rho (n + 1) t * Zeta3.rho n t =
      4 / (↑n + 1) ^ 2 * ((↑n - t) ^ 2 * Zeta3.rho n (t + 1) ^ 2 - (↑n + 1 - t) ^ 2 * Zeta3.rho n t ^ 2)
@Zeta3.rho_succ_shift : ∀ {K : Type u_1} [inst : Field K] (k : ℕ) (t : K),
  Zeta3.rho (k + 1) (t + 1) = -(t ^ 2 * Zeta3.rho k t) / ((t + ↑k + 1) * (t + ↑k + 2))
@Zeta3.row_step : ∀ {K : Type u_1} [inst : Field K] (n : ℕ),
  1 ≤ n →
    ∀ (t : K),
      t + ↑n ≠ 0 →
        t + ↑n + 1 ≠ 0 →
          (↑n + 1) ^ 3 * (Zeta3.rho (n + 1) t - Zeta3.rho n t) - ↑n ^ 3 * (Zeta3.rho n t - Zeta3.rho (n - 1) t) =
            2 * (2 * ↑n + 1) * (t * (t - 1) * Zeta3.rho n t - t ^ 2 * Zeta3.rho n (t + 1))
@Zeta3.row_identity : ∀ {K : Type u_1} [inst : Field K] (n m : ℕ),
  1 ≤ n →
    ∀ (t : K),
      t + ↑n ≠ 0 →
        t + ↑n + 1 ≠ 0 →
          t + ↑m ≠ 0 →
            (↑n + 1) ^ 3 * (Zeta3.rho (n + 1) t * Zeta3.rho m t - Zeta3.rho n t * Zeta3.rho m t) -
                  ↑n ^ 3 * (Zeta3.rho n t * Zeta3.rho m t - Zeta3.rho (n - 1) t * Zeta3.rho m t) -
                2 * (↑m * (↑m + 1)) * (2 * ↑n + 1) * (Zeta3.rho n t * Zeta3.rho m t) =
              -2 * (2 * ↑n + 1) *
                (t ^ 2 * Zeta3.rho m t * Zeta3.rho n (t + 1) - (t - 1) ^ 2 * Zeta3.rho m (t - 1) * Zeta3.rho n t)
Zeta3.growth_step : ∀ (u : ℕ → ℝ),
  (∀ (n : ℕ),
      1 ≤ n → (↑n + 1) ^ 3 * u (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * u n + ↑n ^ 3 * u (n - 1) = 0) →
    (∀ (n : ℕ), 0 ≤ u n) → (∀ (n : ℕ), 1 ≤ n → u (n - 1) ≤ u n) → ∀ (n : ℕ), 15 ≤ n → 30 * u n ≤ u (n + 1)
Zeta3.growth_pow : ∀ (u : ℕ → ℝ),
  (∀ (n : ℕ),
      1 ≤ n → (↑n + 1) ^ 3 * u (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * u n + ↑n ^ 3 * u (n - 1) = 0) →
    (∀ (n : ℕ), 0 ≤ u n) → (∀ (n : ℕ), 1 ≤ n → u (n - 1) ≤ u n) → ∀ (n : ℕ), 15 ≤ n → 30 ^ (n - 15) * u 15 ≤ u n
@Zeta3.wronskian_const : ∀ {K : Type u_1} [inst : Field K] (u z : ℕ → K),
  (∀ (n : ℕ),
      1 ≤ n → (↑n + 1) ^ 3 * u (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * u n + ↑n ^ 3 * u (n - 1) = 0) →
    (∀ (n : ℕ),
        1 ≤ n → (↑n + 1) ^ 3 * z (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * z n + ↑n ^ 3 * z (n - 1) = 0) →
      ∀ (k : ℕ), 1 ≤ k → ↑k ^ 3 * (u k * z (k - 1) - u (k - 1) * z k) = u 1 * z 0 - u 0 * z 1
@Zeta3.series_partial : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (u z : ℕ → K),
  (∀ (n : ℕ),
      1 ≤ n → (↑n + 1) ^ 3 * u (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * u n + ↑n ^ 3 * u (n - 1) = 0) →
    (∀ (n : ℕ),
        1 ≤ n → (↑n + 1) ^ 3 * z (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * z n + ↑n ^ 3 * z (n - 1) = 0) →
      (∀ (k : ℕ), u k ≠ 0) →
        ∀ (n N : ℕ),
          n ≤ N → z n / u n - z N / u N = ∑ k ∈ Finset.Ioc n N, (u 1 * z 0 - u 0 * z 1) / (↑k ^ 3 * u k * u (k - 1))
Zeta3.aperyU_pos : ∀ (n : ℕ), 0 < Zeta3.aperyU n
Zeta3.aCoeff_mono : ∀ (n k : ℕ), Zeta3.aCoeff n k ≤ Zeta3.aCoeff (n + 1) k
Zeta3.aperyU_mono : ∀ (n : ℕ), Zeta3.aperyU n ≤ Zeta3.aperyU (n + 1)
Zeta3.aperyU_zero : Zeta3.aperyU 0 = 1
Zeta3.aperyU_one : Zeta3.aperyU 1 = 5
Zeta3.aperyU_two : Zeta3.aperyU 2 = 73
Zeta3.aperyU_growth : (∀ (n : ℕ),
    1 ≤ n →
      (↑n + 1) ^ 3 * ↑(Zeta3.aperyU (n + 1)) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * ↑(Zeta3.aperyU n) +
          ↑n ^ 3 * ↑(Zeta3.aperyU (n - 1)) =
        0) →
  ∀ (n : ℕ), 15 ≤ n → 30 * ↑(Zeta3.aperyU n) ≤ ↑(Zeta3.aperyU (n + 1))
Zeta3.recTerm_succ : ∀ (m k : ℕ), Zeta3.recTerm m (k + 1) = Zeta3.certB (m + 1) (k + 1) - Zeta3.certB (m + 1) k
Zeta3.aperyU_recurrence_shift : ∀ (m : ℕ),
  (↑m + 2) ^ 3 * ↑(Zeta3.aperyU (m + 2)) -
        (34 * (↑m + 1) ^ 3 + 51 * (↑m + 1) ^ 2 + 27 * (↑m + 1) + 5) * ↑(Zeta3.aperyU (m + 1)) +
      (↑m + 1) ^ 3 * ↑(Zeta3.aperyU m) =
    0
Zeta3.aperyU_recurrence : ∀ (n : ℕ),
  1 ≤ n →
    (↑n + 1) ^ 3 * ↑(Zeta3.aperyU (n + 1)) =
      (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * ↑(Zeta3.aperyU n) - ↑n ^ 3 * ↑(Zeta3.aperyU (n - 1))
Zeta3.aperyU_growth_uncond : ∀ (n : ℕ), 15 ≤ n → 30 * ↑(Zeta3.aperyU n) ≤ ↑(Zeta3.aperyU (n + 1))
Zeta3.tableU_symm : ∀ (n m : ℕ), Zeta3.tableU n m = Zeta3.tableU m n
Zeta3.tableU_diag : ∀ (n : ℕ), Zeta3.tableU n n = Zeta3.aperyU n
Zeta3.tableU_row : ∀ (n m : ℕ),
  1 ≤ n →
    (↑n + 1) ^ 3 * ↑(Zeta3.tableU (n + 1) m) + ↑n ^ 3 * ↑(Zeta3.tableU (n - 1) m) =
      (↑n ^ 3 + (↑n + 1) ^ 3 + 2 * ↑m * (↑m + 1) * (2 * ↑n + 1)) * ↑(Zeta3.tableU n m)
Zeta3.tableU_mix : ∀ (n : ℕ), ↑(Zeta3.tableU (n + 1) (n + 1)) + ↑(Zeta3.tableU n n) = 6 * ↑(Zeta3.tableU (n + 1) n)
Zeta3.aperyU_recurrence_via_table : ∀ (n : ℕ),
  1 ≤ n →
    (↑n + 1) ^ 3 * ↑(Zeta3.aperyU (n + 1)) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * ↑(Zeta3.aperyU n) +
        ↑n ^ 3 * ↑(Zeta3.aperyU (n - 1)) =
      0
Zeta3.tendsto_zero_of_contract : ∀ (e δ : ℕ → ℝ) (c : ℝ) (N : ℕ),
  (∀ (n : ℕ), 0 ≤ e n) →
    Filter.Tendsto δ Filter.atTop (nhds 0) →
      0 ≤ c → c < 1 → (∀ (n : ℕ), N ≤ n → e (n + 1) ≤ δ n + c * e n) → Filter.Tendsto e Filter.atTop (nhds 0)
Zeta3.mu_eq_pow_four : 17 + 12 * √2 = (1 + √2) ^ 4
Zeta3.mu_add_inv : 17 + 12 * √2 + 1 / (17 + 12 * √2) = 34
Zeta3.ratio_tendsto : ∀ (u : ℕ → ℝ),
  (∀ (n : ℕ),
      1 ≤ n → (↑n + 1) ^ 3 * u (n + 1) - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * u n + ↑n ^ 3 * u (n - 1) = 0) →
    (∀ (n : ℕ), 0 < u n) →
      (∀ (n : ℕ), 15 ≤ n → 30 * u n ≤ u (n + 1)) →
        Filter.Tendsto (fun n => u (n + 1) / u n) Filter.atTop (nhds (17 + 12 * √2))
Zeta3.aperyU_ratio_tendsto : Filter.Tendsto (fun n => ↑(Zeta3.aperyU (n + 1)) / ↑(Zeta3.aperyU n)) Filter.atTop
  (nhds (17 + 12 * √2))
Zeta3.halfstep_tendsto : ∀ (u h : ℕ → ℝ),
  (∀ (n : ℕ), 0 < u n) →
    Filter.Tendsto (fun n => u (n + 1) / u n) Filter.atTop (nhds (17 + 12 * √2)) →
      (∀ (n : ℕ), u (n + 1) + u n = 6 * h n) →
        Filter.Tendsto (fun n => h n / u n) Filter.atTop (nhds (3 + 2 * √2)) ∧
          Filter.Tendsto (fun n => u (n + 1) / h n) Filter.atTop (nhds (3 + 2 * √2))
Zeta3.aperyU_halfstep_tendsto : ∀ (h : ℕ → ℝ),
  (∀ (n : ℕ), ↑(Zeta3.aperyU (n + 1)) + ↑(Zeta3.aperyU n) = 6 * h n) →
    Filter.Tendsto (fun n => h n / ↑(Zeta3.aperyU n)) Filter.atTop (nhds (3 + 2 * √2)) ∧
      Filter.Tendsto (fun n => ↑(Zeta3.aperyU (n + 1)) / h n) Filter.atTop (nhds (3 + 2 * √2))
@Zeta3.sigma_succ : ∀ {K : Type u_1} [inst : Field K] (m : ℕ) (t : K),
  Zeta3.sigma (m + 1) t = Zeta3.sigma m t * (↑m + 1) / (t + ↑m + 1)
@Zeta3.sigma_shift : ∀ {K : Type u_1} [inst : Field K] (m : ℕ) (t : K),
  t - 1 ≠ 0 → t + ↑m ≠ 0 → (t - 1) * Zeta3.sigma m (t - 1) = (t + ↑m) * Zeta3.sigma m t
@Zeta3.zeta2_row : ∀ {K : Type u_1} [inst : Field K] (n m : ℕ),
  1 ≤ n →
    ∀ (t : K),
      t + ↑n ≠ 0 →
        t + ↑n + 1 ≠ 0 →
          t + ↑m ≠ 0 →
            (↑n + 1) ^ 2 * Zeta3.rho (n + 1) t * Zeta3.sigma m t -
                  (2 * ↑n + 1) * (2 * ↑m + 1) * Zeta3.rho n t * Zeta3.sigma m t -
                ↑n ^ 2 * Zeta3.rho (n - 1) t * Zeta3.sigma m t =
              2 * (2 * ↑n + 1) *
                (t * Zeta3.sigma m t * Zeta3.rho n (t + 1) - (t - 1) * Zeta3.sigma m (t - 1) * Zeta3.rho n t)
@Zeta3.zeta2_diag : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (n : ℕ) (t : K),
  t + ↑n + 1 ≠ 0 →
    2 * Zeta3.rho (n + 1) t * Zeta3.sigma (n + 1) t - Zeta3.rho n t * Zeta3.sigma n t -
        5 * Zeta3.rho (n + 1) t * Zeta3.sigma n t =
      -(4 / (↑n + 1)) *
        ((t - ↑n) * Zeta3.rho n (t + 1) * Zeta3.sigma n (t + 1) - (t - 1 - ↑n) * Zeta3.rho n t * Zeta3.sigma n t)
@Zeta3.zeta2_third : ∀ {K : Type u_1} [inst : Field K] (n : ℕ) (t : K),
  t + ↑n + 1 ≠ 0 → (Zeta3.rho n t + Zeta3.rho (n + 1) t) * Zeta3.sigma n t = 2 * Zeta3.rho n t * Zeta3.sigma (n + 1) t
@Zeta3.certificate : ∀ {K : Type u_1} [inst : Field K] (n : ℕ),
  1 ≤ n →
    ∀ (t : K),
      t + ↑n ≠ 0 →
        t + ↑n + 1 ≠ 0 →
          (↑n + 1) ^ 3 * Zeta3.rho (n + 1) t ^ 2 - (34 * ↑n ^ 3 + 51 * ↑n ^ 2 + 27 * ↑n + 5) * Zeta3.rho n t ^ 2 +
              ↑n ^ 3 * Zeta3.rho (n - 1) t ^ 2 =
            4 * (2 * ↑n + 1) * (-2 * (t + 1) ^ 2 + (t + 1) + (2 * ↑n + 1) ^ 2) * Zeta3.rho n (t + 1) ^ 2 -
              4 * (2 * ↑n + 1) * (-2 * t ^ 2 + t + (2 * ↑n + 1) ^ 2) * Zeta3.rho n t ^ 2
@Zeta3.certificate_s : ∀ {K : Type u_1} [inst : Field K] (n : ℕ) (t : K),
  4 * (↑n + 1) * (↑n + 1 - t) ^ 2 + 12 * (2 * ↑n + 1) * (↑n + 1 - t) * (↑n + t) + 4 * ↑n * (↑n + t) ^ 2 =
    4 * (2 * ↑n + 1) * (-2 * t ^ 2 + t + (2 * ↑n + 1) ^ 2)
@Zeta3.col_identity : ∀ {K : Type u_1} [inst : Field K] (n l : ℕ) (t : K),
  t + ↑n + 1 ≠ 0 →
    t + ↑l + 1 ≠ 0 →
      (↑l + 1) ^ 3 * Zeta3.rho n t * Zeta3.rho (l + 1) t - (↑n + 1) ^ 3 * Zeta3.rho (n + 1) t * Zeta3.rho l t -
          (↑l + 1 - (↑n + 1)) * ((↑n + 1) ^ 2 - (↑n + 1) * (↑l + 1) + (↑l + 1) ^ 2) * Zeta3.rho n t * Zeta3.rho l t =
        2 * (↑n + 1 - (↑l + 1)) *
          ((t - ↑n) * (t - ↑l) * Zeta3.rho n (t + 1) * Zeta3.rho l (t + 1) -
            (t - 1 - ↑n) * (t - 1 - ↑l) * Zeta3.rho n t * Zeta3.rho l t)
@Zeta3.log2_identity : ∀ {K : Type u_1} [inst : Field K] (n : ℕ),
  1 ≤ n →
    ∀ (t : K),
      t + ↑n ≠ 0 →
        t + ↑n + 1 ≠ 0 →
          (↑n + 1) * Zeta3.rho (n + 1) t - 3 * (2 * ↑n + 1) * Zeta3.rho n t + ↑n * Zeta3.rho (n - 1) t =
            -2 * (2 * ↑n + 1) * (Zeta3.rho n (t + 1) + Zeta3.rho n t)
@Zeta3.zeta2_rec_of_three : ∀ {K : Type u_1} [inst : Field K],
  2 ≠ 0 →
    5 ≠ 0 →
      ∀ (T : ℕ → ℕ → K),
        (∀ (n m : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * T (n + 1) m = (2 * ↑n + 1) * (2 * ↑m + 1) * T n m + ↑n ^ 2 * T (n - 1) m) →
          (∀ (n : ℕ), 2 * T (n + 1) (n + 1) - T n n = 5 * T (n + 1) n) →
            (∀ (n : ℕ), T n n + T (n + 1) n = 2 * T n (n + 1)) →
              ∀ (n : ℕ),
                1 ≤ n →
                  (↑n + 1) ^ 2 * T (n + 1) (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * T n n + ↑n ^ 2 * T (n - 1) (n - 1)
@Zeta3.zeta2_wronskian_step : ∀ {K : Type u_1} [inst : Field K] (u z : ℕ → K),
  (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * u (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n + ↑n ^ 2 * u (n - 1)) →
    (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * z (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * z n + ↑n ^ 2 * z (n - 1)) →
      ∀ (k : ℕ),
        1 ≤ k → (↑k + 1) ^ 2 * (u (k + 1) * z k - u k * z (k + 1)) = -(↑k ^ 2 * (u k * z (k - 1) - u (k - 1) * z k))
@Zeta3.zeta2_wronskian_const : ∀ {K : Type u_1} [inst : Field K] (u z : ℕ → K),
  (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * u (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n + ↑n ^ 2 * u (n - 1)) →
    (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * z (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * z n + ↑n ^ 2 * z (n - 1)) →
      ∀ (k : ℕ), 1 ≤ k → ↑k ^ 2 * (u k * z (k - 1) - u (k - 1) * z k) = (-1) ^ (k - 1) * (u 1 * z 0 - u 0 * z 1)
@Zeta3.zeta2_series_partial : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (u z : ℕ → K),
  (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * u (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n + ↑n ^ 2 * u (n - 1)) →
    (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * z (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * z n + ↑n ^ 2 * z (n - 1)) →
      (∀ (k : ℕ), u k ≠ 0) →
        ∀ (n N : ℕ),
          n ≤ N →
            z n / u n - z N / u N =
              ∑ k ∈ Finset.Ioc n N, (-1) ^ (k - 1) * (u 1 * z 0 - u 0 * z 1) / (↑k ^ 2 * u k * u (k - 1))
Zeta3.zeta2_growth_basic : ∀ (u : ℕ → ℝ),
  (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * u (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n + ↑n ^ 2 * u (n - 1)) →
    (∀ (n : ℕ), 0 ≤ u n) → ∀ (n : ℕ), 1 ≤ n → (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n ≤ (↑n + 1) ^ 2 * u (n + 1)
Zeta3.zeta2_growth_three : ∀ (u : ℕ → ℝ),
  (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * u (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n + ↑n ^ 2 * u (n - 1)) →
    (∀ (n : ℕ), 0 ≤ u n) → ∀ (n : ℕ), 1 ≤ n → 3 * u n ≤ u (n + 1)
Zeta3.zeta2_growth_three_all : ∀ (u : ℕ → ℝ),
  (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * u (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n + ↑n ^ 2 * u (n - 1)) →
    (∀ (n : ℕ), 0 ≤ u n) → 3 * u 0 ≤ u 1 → ∀ (n : ℕ), 3 * u n ≤ u (n + 1)
Zeta3.zeta2_growth_ten : ∀ (u : ℕ → ℝ),
  (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * u (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n + ↑n ^ 2 * u (n - 1)) →
    (∀ (n : ℕ), 0 ≤ u n) → ∀ (n : ℕ), 10 ≤ n → 10 * u n ≤ u (n + 1)
Zeta3.zeta2_growth_pow : ∀ (u : ℕ → ℝ),
  (∀ (n : ℕ), 1 ≤ n → (↑n + 1) ^ 2 * u (n + 1) = (11 * ↑n ^ 2 + 11 * ↑n + 3) * u n + ↑n ^ 2 * u (n - 1)) →
    (∀ (n : ℕ), 0 ≤ u n) → ∀ (n : ℕ), 10 ≤ n → 10 ^ (n - 10) * u 10 ≤ u n
Zeta3.U2_row : ∀ (n m : ℕ),
  1 ≤ n →
    (↑n + 1) ^ 2 * ↑(Zeta3.U2 (n + 1) m) =
      (2 * ↑n + 1) * (2 * ↑m + 1) * ↑(Zeta3.U2 n m) + ↑n ^ 2 * ↑(Zeta3.U2 (n - 1) m)
Zeta3.U2_diag : ∀ (n : ℕ), 2 * ↑(Zeta3.U2 (n + 1) (n + 1)) - ↑(Zeta3.U2 n n) = 5 * ↑(Zeta3.U2 (n + 1) n)
Zeta3.U2_third : ∀ (n : ℕ), ↑(Zeta3.U2 n n) + ↑(Zeta3.U2 (n + 1) n) = 2 * ↑(Zeta3.U2 n (n + 1))
Zeta3.zeta2B_recurrence : ∀ (n : ℕ),
  1 ≤ n → (n + 1) ^ 2 * Zeta3.zeta2B (n + 1) = (11 * n ^ 2 + 11 * n + 3) * Zeta3.zeta2B n + n ^ 2 * Zeta3.zeta2B (n - 1)
Zeta3.zeta2B_zero : Zeta3.zeta2B 0 = 1
Zeta3.zeta2B_one : Zeta3.zeta2B 1 = 3
Zeta3.zeta2B_two : Zeta3.zeta2B 2 = 19
