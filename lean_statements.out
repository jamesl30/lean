        1 ≤ n →
          0 < ↑(Zeta3.aperyU n) * ∑' (k : ℕ), 1 / (↑k + 1) ^ 3 - ↑(v n) ∧
            ↑(Zeta3.aperyU n) * ∑' (k : ℕ), 1 / (↑k + 1) ^ 3 - ↑(v n) < 3 / (↑n ^ 2 * ↑(Zeta3.aperyU n))) →
